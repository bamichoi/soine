generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// 서비스는 PostgreSQL 스키마로 논리적으로 분리한다 (ADR-0003).
// 초이돌상 테이블은 choidolsang 스키마, 끼루 테이블은 kkiru 스키마에 둔다.
// 두 스키마의 테이블은 서로 관계를 맺지 않는다.
datasource db {
  provider = "postgresql"
  schemas  = ["choidolsang", "kkiru"]
}

// ─────────────────────────────── choidolsang ───────────────────────────────

/// 초이돌상 백오피스 관리자 계정.
model ChoidolsangAdmin {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(254)
  name                String    @db.VarChar(100)
  passwordHash        String    @db.VarChar(255)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@map("admins")
  @@schema("choidolsang")
}

/// connect-pg-simple이 쓰는 초이돌상 관리자 세션 테이블.
model ChoidolsangAdminSession {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "admin_sessions_expire_idx")
  @@map("admin_sessions")
  @@schema("choidolsang")
}

/// 초이돌상 문의 처리 상태.
enum ChoidolsangInquiryStatus {
  pending // 대기
  confirmed // 예약확정
  rejected // 거절
  cancelled // 취소 (예약확정 후 예약이 취소됨)

  @@map("inquiry_status")
  @@schema("choidolsang")
}

/// 초이돌상 고객 문의.
model ChoidolsangInquiry {
  id                   String                     @id @default(uuid()) @db.Uuid
  /// 화면·주소에 쓰는 문의 번호. 순서가 드러나지 않는 8자리 무작위 코드 (예: 7K3FQ9AM).
  code                 String                     @unique @db.VarChar(16)
  /// 문의 날짜. 로그 첫 기록의 날짜와 같게 유지한다(목록 정렬용).
  inquiredOn           DateTime                   @db.Date
  /// 희망 예약 날짜·시간
  desiredReservationAt DateTime?                  @db.Timestamptz(3)
  /// 장소
  location             String?                    @db.VarChar(200)
  /// 희망 돌상 컨셉 (돌상 컨셉 참조). 숨김 삭제된 컨셉도 참조는 유지한다.
  desiredConceptId     String?                    @db.Uuid
  desiredConcept       ChoidolsangConcept?        @relation(fields: [desiredConceptId], references: [id], onDelete: Restrict)
  status               ChoidolsangInquiryStatus   @default(pending)
  /// 거절 사유. 거절(rejected) 상태일 때만 값이 있다.
  rejectionReason      String?                    @db.Text
  /// 숨김 삭제 시각. 값이 있으면 목록·상세에서 보이지 않는다.
  deletedAt            DateTime?                  @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)
  /// 문의 내용 로그. 첫 기록이 첫 문의다.
  records              ChoidolsangInquiryRecord[]
  /// 이 문의로 만든 예약 (문의 하나에 예약 하나)
  reservation          ChoidolsangReservation?

  @@index([inquiredOn(sort: Desc), createdAt(sort: Desc)], map: "inquiries_inquired_on_idx")
  @@index([desiredConceptId], map: "inquiries_desired_concept_id_idx")
  @@map("inquiries")
  @@schema("choidolsang")
}

/// 문의 내용 로그. 첫 문의와 그 뒤에 이어진 문의를 기록 하나씩 쌓는다. 문의마다 1개 이상.
model ChoidolsangInquiryRecord {
  id         String             @id @default(uuid()) @db.Uuid
  inquiryId  String             @db.Uuid
  inquiry    ChoidolsangInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// 기록 날짜 (필수)
  recordedOn DateTime           @db.Date
  /// 기록 내용 (필수)
  content    String             @db.Text
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  @@index([inquiryId, recordedOn, createdAt], map: "inquiry_records_inquiry_id_idx")
  @@map("inquiry_records")
  @@schema("choidolsang")
}

// ────────────────────────────────── kkiru ──────────────────────────────────

/// 끼루 백오피스 관리자 계정.
model KkiruAdmin {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(254)
  name                String    @db.VarChar(100)
  passwordHash        String    @db.VarChar(255)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@map("admins")
  @@schema("kkiru")
}

/// connect-pg-simple이 쓰는 끼루 관리자 세션 테이블.
model KkiruAdminSession {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "admin_sessions_expire_idx")
  @@map("admin_sessions")
  @@schema("kkiru")
}

/// 초이돌상 돌상 컨셉. 고객에게 파는 돌상 세트 상품이다.
model ChoidolsangConcept {
  id         String    @id @default(uuid()) @db.Uuid
  /// 컨셉 이름 (필수)
  name       String    @db.VarChar(100)
  /// 구성품 목록. 하나씩 추가한 순서대로 저장한다.
  components String[]  @default([])
  /// 가격 (원, 필수)
  price      Int
  /// 숨김 삭제 시각. 값이 있으면 목록·상세에서 보이지 않는다.
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  /// 이 컨셉을 희망한 문의
  inquiries    ChoidolsangInquiry[]
  /// 이 컨셉으로 잡은 예약
  reservations ChoidolsangReservation[]

  @@index([createdAt(sort: Desc)], map: "concepts_created_at_idx")
  @@map("concepts")
  @@schema("choidolsang")
}

/// 초이돌상 예약 상태
enum ChoidolsangReservationStatus {
  reserved // 예약중
  cancelled // 취소환불
  completed // 완료

  @@map("reservation_status")
  @@schema("choidolsang")
}

/// 아기 성별
enum ChoidolsangBabyGender {
  boy // 남아
  girl // 여아

  @@map("baby_gender")
  @@schema("choidolsang")
}

/// 초이돌상 예약. 항상 문의 하나에서 만들어진다(문의 하나에 예약 하나).
model ChoidolsangReservation {
  id              String                       @id @default(uuid()) @db.Uuid
  /// 화면·주소에 쓰는 예약 번호. 8자리 무작위 코드
  code            String                       @unique @db.VarChar(16)
  /// 예약을 만든 문의
  inquiryId       String                       @unique @db.Uuid
  inquiry         ChoidolsangInquiry           @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  /// 예약자 성함
  customerName    String                       @db.VarChar(100)
  /// 예약자 연락처. 숫자만 저장한다 (예: 01012345678)
  customerPhone   String                       @db.VarChar(20)
  /// 행사 날짜·시간
  eventAt         DateTime                     @db.Timestamptz(3)
  /// 행사 장소
  eventLocation   String                       @db.VarChar(200)
  /// 아기 이름
  babyName        String                       @db.VarChar(100)
  /// 아기 성별
  babyGender      ChoidolsangBabyGender
  /// 돌상 컨셉
  conceptId       String                       @db.Uuid
  concept         ChoidolsangConcept           @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  /// 참석 인원
  guestCount      Int
  /// 스냅 촬영 여부
  hasSnap         Boolean                      @default(false)
  /// 추가 요청 사항
  requests        String?                      @db.Text
  /// 추가 요청 구성품 목록
  extraComponents String[]                     @default([])
  /// 최종 결제 금액 (원). 잔금 = 최종 결제 금액 - 예약금
  totalAmount     Int
  /// 예약금 (원)
  depositAmount   Int                          @default(50000)
  /// 예약 확정 날짜
  confirmedOn     DateTime                     @db.Date
  status          ChoidolsangReservationStatus @default(reserved)
  /// 취소환불 처리 시각
  cancelledAt     DateTime?                    @db.Timestamptz(3)
  /// 업무 완료 처리 시각. 매출 집계 기준이 된다.
  completedAt     DateTime?                    @db.Timestamptz(3)
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                     @updatedAt @db.Timestamptz(3)

  @@index([eventAt(sort: Desc)], map: "reservations_event_at_idx")
  @@index([conceptId], map: "reservations_concept_id_idx")
  @@map("reservations")
  @@schema("choidolsang")
}

// ───────────────────────── 끼루 (부동산 중개) ─────────────────────────
// 고객(임차인) → 미팅(미팅 매물 여러 개) → 계약(미팅 매물 하나). 한 미팅에 계약이 여러 개 생길 수 있다(ADR-0009).
// 끼루 데이터는 삭제하지 않는다.

/// 끼루 고객(임차인). 연락처로 같은 사람인지 찾는다.
model KkiruCustomer {
  id        String         @id @default(uuid()) @db.Uuid
  /// 화면·주소에 쓰는 고객 번호. 8자리 무작위 코드
  code      String         @unique @db.VarChar(16)
  name      String         @db.VarChar(100)
  /// 연락처. 숫자만 저장하며 고객마다 하나뿐이다.
  phone     String         @unique @db.VarChar(20)
  /// 고객 메모 (선택)
  memo      String?        @db.Text
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  meetings  KkiruMeeting[]

  @@map("customers")
  @@schema("kkiru")
}

enum KkiruListingStatus {
  available // 계약가능
  meeting // 미팅중
  contracting // 계약중
  contracted // 계약완료

  @@map("listing_status")
  @@schema("kkiru")
}

/// 끼루 매물(임대). 계약완료된 매물이 다시 나오면 새로 등록한다.
model KkiruListing {
  id             String                @id @default(uuid()) @db.Uuid
  /// 매물 번호. 8자리 무작위 코드
  code           String                @unique @db.VarChar(16)
  name           String                @db.VarChar(100)
  address        String                @db.VarChar(300)
  /// 면적(㎡). 화면에서 평으로 함께 보여 준다.
  areaM2         Decimal               @db.Decimal(10, 2)
  /// 층수 (예: 1층, 지하1층, 2~3층)
  floor          String                @db.VarChar(50)
  /// 임대료(월세, 만원)
  rent           Int
  /// 보증금(만원)
  deposit        Int
  /// 권리금(만원)
  premium        Int
  hasParking     Boolean?
  restroomCount  Int?
  /// 특징 (서술)
  features       String?               @db.Text
  /// 매물 의뢰인
  clientName     String                @db.VarChar(100)
  /// 의뢰인 연락처 (숫자만)
  clientPhone    String                @db.VarChar(20)
  /// 걸린 계약·미팅에서 자동으로 정한다 (common/status-sync.ts)
  status         KkiruListingStatus    @default(available)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  meetings       KkiruMeetingListing[]
  contracts      KkiruContract[]
  /// 이 매물을 관련 매물로 남긴 미팅 기록
  meetingRecords KkiruMeetingRecord[]

  @@index([createdAt(sort: Desc)], map: "listings_created_at_idx")
  @@map("listings")
  @@schema("kkiru")
}

enum KkiruMeetingStatus {
  meeting // 미팅중
  contracting // 계약중
  contracted // 계약완료
  contract_cancelled // 계약취소
  stopped // 진행중단

  @@map("meeting_status")
  @@schema("kkiru")
}

enum KkiruInflowSource {
  naver_land // 네이버부동산
  instagram // 인스타그램
  other // 기타 (직접 입력)

  @@map("inflow_source")
  @@schema("kkiru")
}

/// 끼루 미팅. 고객 한 명과 여러 매물을 두고 진행한다. 케이스 번호는 이 미팅의 계약이 함께 쓴다.
model KkiruMeeting {
  id                 String                @id @default(uuid()) @db.Uuid
  /// 케이스 번호. 8자리 무작위 코드
  code               String                @unique @db.VarChar(16)
  customerId         String                @db.Uuid
  customer           KkiruCustomer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// 고객 화면의 미팅 목록에 보일 이름
  title              String                @db.VarChar(100)
  /// 관심 상권
  interestArea       String                @db.VarChar(200)
  /// 희망 업종
  desiredBusiness    String                @db.VarChar(200)
  /// 희망 평수 범위(평)
  desiredPyeongMin   Decimal               @db.Decimal(8, 2)
  desiredPyeongMax   Decimal               @db.Decimal(8, 2)
  /// 희망 층수 (예: 1층, 1~2층)
  desiredFloor       String                @db.VarChar(50)
  /// 희망 임대료(만원)
  desiredRent        Int
  /// 최대 가용 보증금(만원)
  maxDeposit         Int
  /// 최대 가용 권리금(만원). 예산 = 보증금 + 권리금 (저장하지 않고 계산)
  maxPremium         Int
  inflowSource       KkiruInflowSource
  /// 유입 경로가 기타일 때 직접 입력한 내용
  inflowSourceDetail String?               @db.VarChar(100)
  /// 미팅 일시
  meetAt             DateTime              @db.Timestamptz(3)
  /// 미팅 중단 시각. 값이 있으면 진행중단이다(계약이 진행 중이면 계약 상태가 앞선다).
  stoppedAt          DateTime?             @db.Timestamptz(3)
  /// 계약과 중단 여부로 자동으로 정한다 (common/status-sync.ts)
  status             KkiruMeetingStatus    @default(meeting)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  records            KkiruMeetingRecord[]
  listings           KkiruMeetingListing[]
  contracts          KkiruContract[]

  @@index([customerId], map: "meetings_customer_id_idx")
  @@index([meetAt(sort: Desc), createdAt(sort: Desc)], map: "meetings_meet_at_idx")
  @@map("meetings")
  @@schema("kkiru")
}

enum KkiruMeetingRecordKind {
  note // 미팅 내용
  stopped // 진행중단 사유
  resumed // 미팅재개 사유
  contract_cancelled // 계약취소 사유

  @@map("meeting_record_kind")
  @@schema("kkiru")
}

/// 미팅 내용 로그. 첫 기록이 첫 미팅이다. 중단·재개·계약취소 사유도 여기에 남는다. 지우지 않는다.
model KkiruMeetingRecord {
  id         String                 @id @default(uuid()) @db.Uuid
  meetingId  String                 @db.Uuid
  meeting    KkiruMeeting           @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  kind       KkiruMeetingRecordKind @default(note)
  recordedOn DateTime               @db.Date
  content    String                 @db.Text
  /// 관련 매물(선택). 남길 때는 그 미팅의 미팅 매물이어야 한다. 나중에 미팅 매물에서 빠져도
  /// 기록은 이력이므로 연결을 그대로 둔다.
  listingId  String?                @db.Uuid
  listing    KkiruListing?          @relation(fields: [listingId], references: [id], onDelete: Restrict)
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @db.Timestamptz(3)

  @@index([meetingId, recordedOn, createdAt], map: "meeting_records_meeting_id_idx")
  @@index([listingId], map: "meeting_records_listing_id_idx")
  @@map("meeting_records")
  @@schema("kkiru")
}

/// 미팅 매물: 미팅에서 고객에게 권한 매물
model KkiruMeetingListing {
  meetingId String       @db.Uuid
  meeting   KkiruMeeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  listingId String       @db.Uuid
  listing   KkiruListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@id([meetingId, listingId])
  @@index([listingId], map: "meeting_listings_listing_id_idx")
  @@map("meeting_listings")
  @@schema("kkiru")
}

enum KkiruContractStatus {
  contracting // 계약중
  completed // 계약완료
  cancelled // 계약취소

  @@map("contract_status")
  @@schema("kkiru")
}

/// 끼루 계약. 미팅에서 매물 하나를 골라 만든다. 한 미팅에 계약중인 계약은 하나뿐이고,
/// 계약완료된 계약이 있으면 새 계약을 만들지 않는다(계약 생성 시 검사).
/// 계약이 취소된 뒤에는 같은 미팅에서 새 계약을 만들 수 있다.
model KkiruContract {
  id            String              @id @default(uuid()) @db.Uuid
  meetingId     String              @db.Uuid
  meeting       KkiruMeeting        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  /// 대상 매물
  listingId     String              @db.Uuid
  listing       KkiruListing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  contractedOn  DateTime            @db.Date
  /// 임대인 (매물 의뢰인과 같으면 계약 시점 값을 복사)
  landlordName  String              @db.VarChar(100)
  landlordPhone String              @db.VarChar(20)
  /// 실제 계약 금액(만원). 매물 등록 금액과 다를 수 있다.
  deposit       Int
  rent          Int
  premium       Int
  /// 임대차 기간
  leaseStartOn  DateTime            @db.Date
  leaseEndOn    DateTime            @db.Date
  specialTerms  String?             @db.Text
  /// 계약금(만원)
  downPayment   Int
  /// 잔금(만원). 기본값은 보증금 − 계약금이지만 직접 고칠 수 있다.
  balance       Int
  /// 잔금일. 계약 일자와 같거나 뒤다.
  balanceDueOn  DateTime            @db.Date
  /// 수수료(만원). 수입 집계에 쓴다.
  commission    Int
  isMyListing   Boolean
  isMyClient    Boolean
  status        KkiruContractStatus @default(contracting)
  /// 계약취소 사유 (미팅 로그에도 남긴다)
  cancelReason  String?             @db.Text
  completedAt   DateTime?           @db.Timestamptz(3)
  cancelledAt   DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  @@index([meetingId], map: "contracts_meeting_id_idx")
  @@index([listingId], map: "contracts_listing_id_idx")
  @@index([contractedOn(sort: Desc)], map: "contracts_contracted_on_idx")
  @@index([balanceDueOn], map: "contracts_balance_due_on_idx")
  @@map("contracts")
  @@schema("kkiru")
}
