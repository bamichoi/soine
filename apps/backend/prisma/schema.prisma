generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// 서비스는 PostgreSQL 스키마로 논리적으로 분리한다 (ADR-0003).
// 초이돌상 테이블은 choidolsang 스키마, 끼루 테이블은 kkiru 스키마에 둔다.
// 두 스키마의 테이블은 서로 관계를 맺지 않는다.
datasource db {
  provider = "postgresql"
  schemas  = ["choidolsang", "kkiru"]
}

// ─────────────────────────────── choidolsang ───────────────────────────────

/// 초이돌상 백오피스 관리자 계정.
model ChoidolsangAdmin {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(254)
  name                String    @db.VarChar(100)
  passwordHash        String    @db.VarChar(255)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@map("admins")
  @@schema("choidolsang")
}

/// connect-pg-simple이 쓰는 초이돌상 관리자 세션 테이블.
model ChoidolsangAdminSession {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "admin_sessions_expire_idx")
  @@map("admin_sessions")
  @@schema("choidolsang")
}

/// 초이돌상 문의 처리 상태.
enum ChoidolsangInquiryStatus {
  pending // 대기
  confirmed // 예약확정
  rejected // 거절
  cancelled // 취소 (예약확정 후 예약이 취소됨)

  @@map("inquiry_status")
  @@schema("choidolsang")
}

/// 초이돌상 고객 문의.
model ChoidolsangInquiry {
  id                   String                   @id @default(uuid()) @db.Uuid
  /// 화면·주소에 쓰는 문의 번호. 순서가 드러나지 않는 8자리 무작위 코드 (예: 7K3FQ9AM).
  code                 String                   @unique @db.VarChar(16)
  /// 문의 날짜 (필수)
  inquiredOn           DateTime                 @db.Date
  /// 문의 내용 (필수)
  content              String                   @db.Text
  /// 희망 예약 날짜·시간
  desiredReservationAt DateTime?                @db.Timestamptz(3)
  /// 장소
  location             String?                  @db.VarChar(200)
  /// 희망 돌상 컨셉. 돌상 컨셉 테이블이 생기면 참조로 바꾼다.
  desiredConcept       String?                  @db.VarChar(200)
  status               ChoidolsangInquiryStatus @default(pending)
  /// 거절 사유. 거절(rejected) 상태일 때만 값이 있다.
  rejectionReason      String?                  @db.Text
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([inquiredOn(sort: Desc), createdAt(sort: Desc)], map: "inquiries_inquired_on_idx")
  @@map("inquiries")
  @@schema("choidolsang")
}

// ────────────────────────────────── kkiru ──────────────────────────────────

/// 끼루 백오피스 관리자 계정.
model KkiruAdmin {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(254)
  name                String    @db.VarChar(100)
  passwordHash        String    @db.VarChar(255)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@map("admins")
  @@schema("kkiru")
}

/// connect-pg-simple이 쓰는 끼루 관리자 세션 테이블.
model KkiruAdminSession {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "admin_sessions_expire_idx")
  @@map("admin_sessions")
  @@schema("kkiru")
}
